# Copy this file to .env (which is gitignored) and fill in your own value.
# Connection string for your hosted Postgres database (Neon, Supabase, ...).
# Most hosted providers require sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: a separate, empty database for the server's Postgres tests
# (apps/server/src/store/prisma.test.ts). Every table in it is wiped before each
# test, so never use your development database here. With Neon, a branch works well.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_TEST?sslmode=require"
