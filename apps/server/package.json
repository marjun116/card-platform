{
  "name": "@card-table/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/tables/protocol.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/db-check.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "tsx --env-file-if-exists=../../.env scripts/migrate-test-db.ts"
  },
  "dependencies": {
    "@card-table/engine": "workspace:*",
    "@card-table/games": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/websocket": "^11.3.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15"
  }
}
