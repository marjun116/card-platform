{
  "name": "@card-table/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/db-check.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@card-table/engine": "workspace:*",
    "@card-table/games": "workspace:*",
    "@fastify/websocket": "^11.3.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "^4.23.15"
  }
}
